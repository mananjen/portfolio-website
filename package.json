{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsx scripts/inject-meta.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "inject-meta": "tsx scripts/inject-meta.ts",
    "deploy": "npm run build && gh-pages -d dist",
    "prototype": "vite --open /src/pages/portfolio-prototype.html",
    "prototype:reading": "vite --open /src/pages/project-reading-prototype.html",
    "dev:v3": "npm --prefix v3 run dev",
    "check:v3": "npm --prefix v3 run check",
    "build:v3": "npm --prefix v3 run build",
    "preview:v3": "npm --prefix v3 run preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^7.0.3",
    "gh-pages": "6.1.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
