---
import Layout from "../layouts/Layout.astro"
import ProjectCard from "../components/ProjectCard.astro"
import { projectPage } from "../content/site"
import { featuredProjects, additionalProjects } from "../content/projects"
---
<Layout page="projects" title={projectPage.title} description={projectPage.description}>
  <div class="container">
    <section class="intro"><p class="eyebrow">{projectPage.eyebrow}</p><h1>{projectPage.headline.map(line => <span>{line}</span>)}</h1><p class="muted">{projectPage.description}</p></section>
    {featuredProjects.length > 0 && <section class="listing" aria-label={projectPage.featuredLabel}><p class="eyebrow">{projectPage.featuredLabel} / {String(featuredProjects.length).padStart(2, "0")}</p>{featuredProjects.map(project => <ProjectCard project={project} />)}</section>}
    {additionalProjects.length > 0 && <section class="listing" aria-label={projectPage.additionalLabel}><p class="eyebrow">{projectPage.additionalLabel} / {String(additionalProjects.length).padStart(2, "0")}</p>{additionalProjects.map(project => <ProjectCard project={project} />)}</section>}
  </div>
</Layout>
<script>
  import "../scripts/project-briefs"
</script>
<style>
  .intro { padding-block: 44px 48px; }
  h1 { margin-block: 18px 24px; font-size: clamp(42px, 5.5vw, 68px); }
  h1 span { display: block; }
  .intro > .muted { max-width: 600px; }
  .listing + .listing { margin-top: 36px; }
  .listing > .eyebrow { margin-bottom: 18px; }
</style>
