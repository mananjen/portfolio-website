---
import { site } from "../content/site"
import { pageUrl } from "../lib/links"
import "../styles/global.css"
interface Props { title?: string; description?: string; page: "home" | "projects" }
const { title = site.title, description = site.description, page } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#204eb7" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">{site.skip}</a>
    <div class:list={['header-wrap', { cobalt: page === "home" }]}>
      <header class="container">
        <a class="wordmark" href={pageUrl()}>{site.name}<span aria-hidden="true">.</span></a>
        <nav aria-label={site.navigationLabel}>
          {site.nav.map(item => <a href={pageUrl(item.path)} aria-current={(item.path === "" ? page === "home" : page === "projects") ? "page" : undefined}>{item.label}</a>)}
          <a href={site.email}>{site.hello}</a>
        </nav>
      </header>
    </div>
    <main id="main"><slot /></main>
    <footer id="contact" class="container">
      <div><p class="eyebrow">{site.footer.eyebrow}</p><a class="contact-title" href={site.email}>{site.footer.title}<span aria-hidden="true"> ↗</span></a></div>
      <div class="footer-links"><div class="actions">{site.footer.links.map(link => <a href={link.href}>{link.label}</a>)}</div><p>{site.footer.signature}</p></div>
    </footer>
  </body>
</html>
<style>
  .header-wrap.cobalt { background: var(--cobalt); }
  header { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding-block: 26px; }
  .wordmark { font-size: 23px; font-weight: 600; text-decoration: none; white-space: nowrap; }
  nav { display: flex; gap: 26px; font-size: 13px; }
  nav a { text-decoration: none; }
  nav a[aria-current] { text-decoration: underline; text-underline-offset: 7px; }
  .skip { position: fixed; top: 8px; left: 8px; z-index: 10; padding: 10px 18px; background: var(--text); color: var(--background); transform: translateY(-150%); }
  .skip:focus { transform: none; }
  footer { display: flex; justify-content: space-between; gap: 30px; padding-block: 40px; margin-top: 50px; border-top: 1px solid var(--line); }
  .contact-title { display: inline-block; font-size: 36px; letter-spacing: -.04em; margin-top: 8px; text-decoration: none; }
  .footer-links { align-self: end; font-size: 13px; }
  .footer-links p { margin-top: 14px; color: var(--muted); font-size: 11px; }
  @media (max-width: 600px) {
    header { flex-wrap: wrap; gap: 14px; padding-block: 20px; }
    nav { gap: 22px; }
    footer { flex-direction: column; }
    .footer-links { align-self: start; }
  }
</style>
