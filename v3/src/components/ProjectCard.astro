---
import type { Project } from "../content/projects"
import { projectLabels } from "../content/site"
import Tags from "./Tags.astro"
interface Props { project: Project }
const { project } = Astro.props
---
<article id={`project-${project.slug}`} class:list={['project', { featured: project.featured }]} data-project={project.slug}>
  <div class="preview">
    <div>
      <p class="eyebrow">{project.category} <span aria-hidden="true">/</span> {project.timeframe}</p>
      <h2>{project.title}</h2>
      <p class="summary">{project.summary}</p>
      {project.role && <p class="role">{project.role}</p>}
      <Tags tags={project.technologies} />
      {project.links.length > 0 && <div class="actions artifacts">{project.links.map(link => <a href={link.href} target="_blank" rel="noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
    </div>
    {project.image && <figure><a href={project.image} target="_blank" rel="noreferrer" aria-label={`${projectLabels.image}: ${project.title}`}><img src={project.image} alt={projectLabels.imageAlt(project.title)} loading="lazy" /></a><figcaption>{projectLabels.image}</figcaption></figure>}
  </div>
  <details data-brief={project.slug}>
    <summary><span class="closed-label">{projectLabels.read} <span aria-hidden="true">↓</span></span><span class="open-label">{projectLabels.close} <span aria-hidden="true">↑</span></span></summary>
    <div class="brief" aria-label={projectLabels.briefLabel(project.title)}>
      {project.brief.map(section => <section><h3>{section.heading}</h3><p>{section.text}</p></section>)}
    </div>
  </details>
</article>
<style>
  .project { padding: 28px 0; border-top: 1px solid var(--line); scroll-margin-top: 24px; min-width: 0; }
  .preview { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px; align-items: center; }
  .preview:not(:has(figure)) { grid-template-columns: 1fr; }
  h2 { font-size: clamp(25px, 3vw, 38px); margin: 12px 0 16px; }
  .summary { color: var(--muted); max-width: 650px; font-size: 15px; }
  .role { color: var(--accent); font-size: 12px; margin-top: 15px; }
  .artifacts { font-size: 13px; }
  figure { max-width: 440px; width: 100%; justify-self: end; }
  figure a { display: grid; place-items: center; background: #dce6f6; padding: 12px; height: 269px; }
  figure img { max-height: 245px; object-fit: contain; }
  figcaption { font-size: 10px; color: var(--muted); margin-top: 8px; }
  details { margin-top: 20px; }
  summary { cursor: pointer; width: fit-content; font-size: 14px; color: var(--accent); padding: 6px 0; }
  summary::marker { color: var(--accent); }
  .open-label, details[open] .closed-label { display: none; }
  details[open] .open-label { display: inline; }
  .brief { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; padding-top: 24px; }
  .brief h3 { font-size: 13px; font-weight: 600; color: var(--accent); margin-bottom: 9px; letter-spacing: 0; }
  .brief p { font-size: 14px; line-height: 1.8; color: var(--muted); }
  @media (max-width: 700px) {
    .preview, .brief { grid-template-columns: 1fr; gap: 24px; }
    figure { justify-self: start; }
    figure a { height: 224px; }
    figure img { max-height: 200px; }
  }
</style>
