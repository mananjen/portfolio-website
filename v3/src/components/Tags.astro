---
import { projectLabels } from "../content/site"
interface Props { tags: string[] }
const { tags } = Astro.props
---
<ul aria-label={projectLabels.technologies}>{tags.map(tag => <li>{tag}</li>)}</ul>
<style>
  ul { display: flex; flex-wrap: wrap; gap: 7px; list-style: none; padding: 0; margin: 18px 0; }
  li { border: 1px solid var(--line); border-radius: 24px; padding: 4px 10px; color: var(--accent); font-size: 11px; }
</style>
